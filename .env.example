# ── Server ──────────────────────────────────────────────
PORT=8787
# Public URL of the deployed app (used for webhooks, request links, deep links)
PUBLIC_APP_URL=http://localhost:5173

# Postgres connection string (e.g. Neon). Leave empty in local dev to use an
# embedded PGlite database stored in ./.data/pglite
DATABASE_URL=

# Random 32+ byte secret for signing session tokens:  openssl rand -base64 32
SESSION_SECRET=
# 32-byte AES-256-GCM key, base64:                    openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ── Provider ────────────────────────────────────────────
# bitrefill (production) | mock (local development and automated tests only)
TOPUP_PROVIDER=bitrefill
BITREFILL_BASE_URL=https://api.bitrefill.com/v2
BITREFILL_API_KEY=          # Personal API (Bearer)
BITREFILL_API_ID=           # Business/Affiliate (Basic) — optional
BITREFILL_API_SECRET=       # Business/Affiliate (Basic) — optional
# Optional shared secret appended to the webhook URL as ?token=… (webhooks are
# only ever used as a trigger; state is always re-fetched from Bitrefill)
WEBHOOK_TOKEN=

# ── Limits ──────────────────────────────────────────────
LIMIT_PER_ORDER_USD=100
LIMIT_PER_DAY_USD=300

# ── Support ─────────────────────────────────────────────
SUPPORT_EMAIL=
SUPPORT_URL=
